# init.aospa.perf.soc.rc applies the schedutil rate limits at boot. Without
# this the writes fail with EACCES and the governor keeps the stock post_boot
# values (up/down rate limit 0).
allow vendor_init sysfs_devices_system_cpu:dir r_dir_perms;
allow vendor_init sysfs_devices_system_cpu:file w_file_perms;

# vendor_init writes persist.vendor.camera.* from /vendor/build.prop.
set_prop(vendor_init, vendor_camera_prop)
# persist.vendor.camera.privapp.list is labelled vendor_persist_camera_prop
set_prop(vendor_init, vendor_persist_camera_prop)

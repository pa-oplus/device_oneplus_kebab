type vendor_kebab_init, domain;
type vendor_kebab_init_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_kebab_init)
allow vendor_kebab_init vendor_shell_exec:file rx_file_perms;
allow vendor_kebab_init vendor_toolbox_exec:file rx_file_perms;
allow vendor_kebab_init proc_cmdline:file r_file_perms;
set_prop(vendor_kebab_init, vendor_radio_prop)

<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.media.omx</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IOmx</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IOmxStore</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.drm</name>
        <transport>hwbinder</transport>
        <version>1.3</version>
        <interface>
            <name>IDrmFactory</name>
            <instance>wfdhdcp</instance>
        </interface>
        <interface>
            <name>ICryptoFactory</name>
            <instance>wfdhdcp</instance>
        </interface>
    </hal>
</manifest>
